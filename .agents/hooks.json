{
  "aligner-git-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/harness/hooks/run.py\" antigravity",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
