{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_generated": [
    "이 파일은 harness/hooks/policies/permissions.json 에서 생성됩니다.",
    "직접 고치지 마세요. 다시 생성: python3 scripts/harness/generate.py"
  ],
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git switch:*)",
      "Bash(git add:*)",
      "Bash(git rev-parse:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git rebase:*)",
      "Bash(gh pr create:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr status:*)",
      "Bash(gh repo view:*)",
      "Bash(gh auth status:*)",
      "Bash(./gradlew ktlintCheck:*)",
      "Bash(./gradlew ktlintFormat:*)",
      "Bash(./gradlew build:*)",
      "Bash(./gradlew test:*)",
      "Bash(./gradlew integrationTest:*)",
      "Bash(./gradlew projects:*)",
      "Bash(./gradlew dependencies:*)",
      "Bash(python3 scripts/harness/generate.py:*)",
      "Bash(python3 scripts/harness/validate.py:*)",
      "Bash(rg:*)",
      "Bash(fd:*)",
      "Bash(ls:*)",
      "Bash(tree:*)"
    ],
    "deny": [
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/application-local.yml)",
      "Read(**/application-secret*.yml)",
      "Read(**/*.key)",
      "Read(**/*.jks)",
      "Read(**/*.p12)"
    ],
    "ask": [
      "Bash(gh pr ready:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh issue create:*)",
      "Bash(gh pr review:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh api:*)",
      "Bash(git rebase --abort:*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": [
        "~/.ssh/**",
        "~/.aws/**",
        "~/.config/gh/**",
        "~/.kube/**",
        "./.env",
        "./.env.*",
        "**/application-local.yml",
        "**/application-secret*.yml",
        "**/*.key",
        "**/*.jks",
        "**/*.p12"
      ],
      "allowRead": [
        "."
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/git-guard.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
